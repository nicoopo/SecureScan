{# templates/form/tailwind_theme.html.twig #}

{% block form_row %}
    <div class="mb-4">
        {{ form_label(form) }}
        {{ form_widget(form) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block form_label %}
    {% if label is not same as(false) %}
        <label{% if id is defined %} for="{{ id }}"{% endif %} class="block text-sm font-medium mb-1">
            {{ label|default(name|replace({'_': ' '})|capitalize) }}
        </label>
    {% endif %}
{% endblock %}

{% block form_widget_simple %}
    {% set type = type|default('text') %}
    <input
        type="{{ type }}"
        {{ block('widget_attributes') }}
        {% if value is defined %}value="{{ value }}"{% endif %}
        class="w-full rounded-md border px-3 py-2 text-sm shadow focus:outline-none focus:ring-2 focus:ring-blue-900 {{ errors|length > 0 ? 'border-red-500' : '' }}"
    />
{% endblock %}

{% block textarea_widget %}
    <textarea
        {{ block('widget_attributes') }}
        class="w-full rounded-md border px-3 py-2 text-sm shadow focus:outline-none focus:ring-2 focus:ring-blue-900 {{ errors|length > 0 ? 'border-red-500' : '' }}"
    >{{ value }}</textarea>
{% endblock %}

{% block choice_widget_collapsed %}
    <select
        {{ block('widget_attributes') }}
        class="w-full rounded-md border px-3 py-2 text-sm shadow focus:outline-none focus:ring-2 focus:ring-blue-900 {{ errors|length > 0 ? 'border-red-500' : '' }}"
    >
        {% if placeholder is not none %}
            <option value=""{% if required and value is empty %} selected{% endif %}>{{ placeholder|trans({}, translation_domain) }}</option>
        {% endif %}
        {% for group_label, choice in choices %}
            {% if choice is iterable %}
                <optgroup label="{{ group_label|trans({}, choice_translation_domain) }}">
                    {% for c in choice %}
                        <option value="{{ c.value }}"{% if c.value == value %} selected{% endif %}>
                            {{ c.label|trans({}, choice_translation_domain) }}
                        </option>
                    {% endfor %}
                </optgroup>
            {% else %}
                <option value="{{ choice.value }}"{% if choice.value == value %} selected{% endif %}>
                    {{ choice.label|trans({}, choice_translation_domain) }}
                </option>
            {% endif %}
        {% endfor %}
    </select>
{% endblock %}

{% block file_widget %}
    <input
        type="file"
        {{ block('widget_attributes') }}
        class="w-full text-sm
               file:mr-3 file:py-2 file:px-3
               file:rounded-md file:border file:border-blue-900
               file:text-sm file:font-medium file:text-blue-900
               file:bg-white file:cursor-pointer
               hover:file:opacity-80"
    />
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <ul class="mt-1">
            {% for error in errors %}
                <li class="text-sm text-red-600">{{ error.message }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}

{% block checkbox_widget %}
    <input
        type="checkbox"
        {{ block('widget_attributes') }}
        {% if value is defined %}value="{{ value }}"{% endif %}
        {% if checked is defined and checked %}checked{% endif %}
        class="rounded border shadow"
    />
{% endblock %}
