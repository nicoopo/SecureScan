{% extends 'layouts/layout.html.twig' %}
{% block title %}Scan #{{ scan.id }}{% endblock %}
{% block head %}
    {% if scan.status in ['pending', 'running'] %}
        <meta http-equiv="refresh" content="3">
    {% endif %}
{% endblock %}
{% block content %}
<div class="max-w-6xl mx-auto px-6 py-8">

    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs text-gray-500 mb-6">
        <a href="{{ path('app_scan_list') }}" class="hover:text-gray-700 transition-colors">Scans</a>
        <span>/</span>
        <span class="text-gray-600">#{{ scan.id }}</span>
    </div>

    <!-- Header -->
    <div class="flex items-start justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 tracking-tight">{{ scan.project.name }}</h1>
            <p class="text-gray-600 mt-1 text-sm">Scan #{{ scan.id }} · Lancé le {{ scan.startedAt|date('d/m/Y à H:i') }}</p>
        </div>
        <!-- Status badge -->
        <div class="flex items-center gap-3">
            {% if scan.status == 'done' or scan.status == 'completed' %}
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium badge-low">
                <span class="w-2 h-2 rounded-full bg-acid inline-block"></span>
                {{ scan.status }}
            </span>
            {% elseif scan.status == 'running' %}
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium badge-medium">
                <span class="w-2 h-2 rounded-full bg-info inline-block animate-pulse"></span>
                {{ scan.status }}
            </span>
            {% elseif scan.status == 'failed' %}
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium badge-critical">
                <span class="w-2 h-2 rounded-full bg-danger inline-block"></span>
                {{ scan.status }}
            </span>
            {% else %}
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium badge-info">{{ scan.status }}</span>
            {% endif %}
        </div>
    </div>

    <!-- Score cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <!-- Score -->
        <div class="rounded-xl border bg-white p-6 shadow-card">
            <p class="text-xs text-gray-600 uppercase tracking-widest mb-3">Score</p>
            {% if scan.score is not null %}
                <p class="text-4xl font-extrabold text-gray-900 leading-none">
                    {{ scan.score }}<span class="text-xl text-gray-500 font-normal">/100</span>
                </p>
            {% else %}
                <p class="text-2xl font-bold text-gray-500">En attente</p>
            {% endif %}
        </div>
        <!-- Grade -->
        <div class="rounded-xl border bg-white p-6 shadow-card">
            <p class="text-xs text-gray-600 uppercase tracking-widest mb-3">Grade</p>
            {% if scan.grade is not null %}
                {% if scan.grade in ['A', 'A+'] %}
                    <p class="text-4xl font-extrabold text-acid leading-none">{{ scan.grade }}</p>
                {% elseif scan.grade == 'B' %}
                    <p class="text-4xl font-extrabold text-info leading-none">{{ scan.grade }}</p>
                {% elseif scan.grade == 'C' %}
                    <p class="text-4xl font-extrabold text-warn leading-none">{{ scan.grade }}</p>
                {% else %}
                    <p class="text-4xl font-extrabold text-danger leading-none">{{ scan.grade }}</p>
                {% endif %}
            {% else %}
                <p class="text-2xl font-bold text-gray-500">En attente</p>
            {% endif %}
        </div>
        <!-- Findings count -->
        <div class="rounded-xl border bg-white p-6 shadow-card">
            <p class="text-xs text-gray-600 uppercase tracking-widest mb-3">Findings</p>
            <p class="text-4xl font-extrabold leading-none {% if scan.findings|length > 0 %}text-warn{% else %}text-acid{% endif %}">
                {{ scan.findings|length }}
            </p>
        </div>
    </div>

    <!-- Findings -->
    <div class="rounded-xl border bg-white shadow-card overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
            <h2 class="font-semibold text-gray-900">Findings</h2>
            <span class="text-xs text-gray-600">{{ scan.findings|length }} résultat{{ scan.findings|length != 1 ? 's' : '' }}</span>
        </div>

        {% if scan.findings is empty %}
            <div class="px-6 py-16 text-center">
                <div class="w-10 h-10 rounded-full bg-gray-100 border border-gray-200 flex items-center justify-center mx-auto mb-3">
                    <svg class="w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <p class="text-gray-900 font-semibold mb-1">Aucune vulnérabilité détectée</p>
                <p class="text-gray-600 text-sm">Ce scan n'a révélé aucun finding.</p>
            </div>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                    <tr class="border-b border-gray-200 text-gray-600 text-xs uppercase tracking-widest">
                        <th class="px-6 py-3.5 text-left">Fichier</th>
                        <th class="px-6 py-3.5 text-left">Ligne</th>
                        <th class="px-6 py-3.5 text-left">Sévérité</th>
                        <th class="px-6 py-3.5 text-left">OWASP</th>
                        <th class="px-6 py-3.5 text-left">Description</th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                    {% for finding in scan.findings %}
                        <tr class="scan-row transition-colors align-top">
                            <td class="px-6 py-4 font-mono text-xs text-gray-700 max-w-[200px] truncate">{{ finding.filePath }}</td>
                            <td class="px-6 py-4 font-mono text-xs text-gray-600">{{ finding.line }}</td>
                            <td class="px-6 py-4">
                                {% set sev = finding.severity|lower %}
                                {% if sev == 'critical' %}
                                    <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold badge-critical font-mono">CRITICAL</span>
                                {% elseif sev == 'high' %}
                                    <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold badge-high font-mono">HIGH</span>
                                {% elseif sev == 'medium' %}
                                    <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold badge-medium font-mono">MEDIUM</span>
                                {% elseif sev == 'low' %}
                                    <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold badge-low font-mono">LOW</span>
                                {% else %}
                                    <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold badge-info font-mono">{{ finding.severity }}</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-xs text-gray-600 whitespace-nowrap">{{ finding.owaspCategory }}</td>
                            <td class="px-6 py-4 text-xs text-gray-700 leading-relaxed max-w-sm">{{ finding.description }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    <!-- Back -->
    <div class="mt-6">
        <a href="{{ path('app_scan_list') }}" class="inline-flex items-center gap-1.5 text-sm text-[#8b949e] hover:text-white transition-colors">
            ← Retour aux scans
        </a>
    </div>

</div>
{% endblock %}
