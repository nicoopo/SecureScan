{% extends 'layouts/layout.html.twig' %}
{% block title %}Nouveau scan{% endblock %}
{% block content %}

    <div class="max-w-2xl mx-auto px-6 py-12">

        <!-- Form Card -->
        <div class="rounded-xl border bg-white shadow-card overflow-hidden">

            <!-- Card Header (shadcn style) -->
            <div class="px-6 pt-8 pb-4">
                <div class="flex flex-col items-center gap-1 text-center">
                    <h1 class="text-2xl font-bold text-gray-900">Lancer un scan</h1>
                    <p class="text-sm text-gray-600 mt-1">Analysez votre code source à la recherche de vulnérabilités de sécurité.</p>
                </div>
            </div>

            {{ form_start(form, {
                'attr': {
                    'enctype': 'multipart/form-data',
                    'class': 'flex flex-col gap-6'
                }
            }) }}

            <!-- Nom du projet -->
            <div class="px-6 py-5">
                {{ form_label(form.name, 'Nom du projet', {'label_attr': {'class': 'block text-sm font-medium mb-2 text-gray-700'}}) }}
                {{ form_widget(form.name, {
                    'attr': {
                        'class': 'w-full rounded-md border px-3 py-2 text-sm shadow focus:outline-none focus:ring-2 focus:ring-blue-900'
                    }
                }) }}
                {{ form_errors(form.name) }}
            </div>

            <!-- Source -->
            <div class="px-6 py-5">
                {{ form_label(form.source, 'Source', {'label_attr': {'class': 'block text-sm font-medium mb-2 text-gray-700'}}) }}
                {{ form_widget(form.source, {
                    'attr': {
                        'class': 'w-full rounded-md border px-3 py-2 text-sm shadow focus:outline-none focus:ring-2 focus:ring-blue-900'
                    }
                }) }}
                {{ form_errors(form.source) }}
            </div>

            <!-- Repository URL -->
            <div class="px-6 py-5">
                {{ form_label(form.repositoryUrl, "URL du dépôt", {'label_attr': {'class': 'block text-sm font-medium mb-2 text-gray-700'}}) }}
                {{ form_widget(form.repositoryUrl, {
                    'attr': {
                        'placeholder': 'https://github.com/user/repo',
                        'class': 'w-full rounded-md border px-3 py-2 text-sm shadow focus:outline-none focus:ring-2 focus:ring-blue-900'
                    }
                }) }}
                {{ form_errors(form.repositoryUrl) }}
            </div>

            <!-- ZIP Upload -->
            <div class="px-6 py-5">
                {{ form_label(form.zipFile, 'Archive ZIP', {'label_attr': {'class': 'block text-sm font-medium mb-2 text-gray-700'}}) }}
                <div class="relative">
                    {{ form_widget(form.zipFile, {
                        'attr': {
                            'class': 'w-full text-sm file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-acid/10 file:text-acid file:cursor-pointer hover:file:bg-acid/20 file:transition-colors cursor-pointer'
                        }
                    }) }}
                </div>
                {{ form_errors(form.zipFile) }}
            </div>

            <!-- Submit -->
            <div class="px-6 py-5 bg-white/0 flex items-center justify-between">
                <a href="{{ path('app_scan_list') }}" class="text-sm text-gray-600 hover:text-gray-900 transition-colors">
                    ← Retour aux scans
                </a>
                <button type="submit" class="w-full max-w-xs flex items-center justify-center gap-2 px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold rounded-lg transition-colors shadow">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 010 1.972l-11.54 6.347a1.125 1.125 0 01-1.667-.986V5.653z"/>
                    </svg>
                    Lancer l'analyse
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>

{% endblock %}
