{% extends 'layouts/layout.html.twig' %}
{% block title %}Nouveau scan{% endblock %}
{% block content %}

    <div class="max-w-2xl mx-auto">

        <!-- Header -->
        <div class="mb-8">
            <div class="inline-flex items-center gap-2 text-xs text-acid font-mono mb-3 px-2.5 py-1 rounded bg-acid/10 border border-acid/20">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                    <circle cx="10" cy="10" r="3"/>
                </svg>
                Nouvelle analyse
            </div>
            <h1 class="text-2xl font-bold text-white tracking-tight">Lancer un scan</h1>
            <p class="text-[#8b949e] mt-1 text-sm">Analysez votre code source à la recherche de vulnérabilités de sécurité.</p>
        </div>

        <!-- Form Card -->
        <div class="rounded-xl border border-night-600 bg-night-800 shadow-card overflow-hidden">

            {{ form_start(form, {
                'attr': {
                    'enctype': 'multipart/form-data',
                    'class': 'divide-y divide-night-700'
                }
            }) }}

            <!-- Nom du projet -->
            <div class="px-6 py-5">
                <label class="block text-xs font-semibold text-[#8b949e] uppercase tracking-widest mb-2 font-mono">
                    Nom du projet
                </label>
                {{ form_widget(form.name, {
                    'attr': {
                        'class': 'w-full bg-night-900 border border-night-600 rounded-lg px-4 py-2.5 text-white text-sm placeholder-[#484f58] focus:outline-none focus:border-acid/50 focus:ring-1 focus:ring-acid/30 transition-colors font-mono'
                    }
                }) }}
                {{ form_errors(form.name) }}
            </div>

            <!-- Source -->
            <div class="px-6 py-5">
                <label class="block text-xs font-semibold text-[#8b949e] uppercase tracking-widest mb-2 font-mono">
                    Source
                </label>
                {{ form_widget(form.source, {
                    'attr': {
                        'class': 'w-full bg-night-900 border border-night-600 rounded-lg px-4 py-2.5 text-white text-sm focus:outline-none focus:border-acid/50 focus:ring-1 focus:ring-acid/30 transition-colors font-mono'
                    }
                }) }}
                {{ form_errors(form.source) }}
            </div>

            <!-- Repository URL -->
            <div class="px-6 py-5">
                <label class="block text-xs font-semibold text-[#8b949e] uppercase tracking-widest mb-2 font-mono">
                    URL du dépôt
                </label>
                {{ form_widget(form.repositoryUrl, {
                    'attr': {
                        'placeholder': 'https://github.com/user/repo',
                        'class': 'w-full bg-night-900 border border-night-600 rounded-lg px-4 py-2.5 text-white text-sm placeholder-[#484f58] focus:outline-none focus:border-acid/50 focus:ring-1 focus:ring-acid/30 transition-colors font-mono'
                    }
                }) }}
                {{ form_errors(form.repositoryUrl) }}
            </div>

            <!-- ZIP Upload -->
            <div class="px-6 py-5">
                <label class="block text-xs font-semibold text-[#8b949e] uppercase tracking-widest mb-2 font-mono">
                    Archive ZIP
                </label>
                <div class="relative">
                    {{ form_widget(form.zipFile, {
                        'attr': {
                            'class': 'w-full text-sm text-[#8b949e] file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-acid/10 file:text-acid file:cursor-pointer hover:file:bg-acid/20 file:transition-colors cursor-pointer'
                        }
                    }) }}
                </div>
                {{ form_errors(form.zipFile) }}
            </div>

            <!-- Submit -->
            <div class="px-6 py-5 bg-night-900/50 flex items-center justify-between">
                <a href="{{ path('app_scan_list') }}" class="text-sm text-[#8b949e] hover:text-white transition-colors">
                    ← Retour aux scans
                </a>
                <button type="submit" class="flex items-center gap-2 px-5 py-2.5 bg-acid text-night-950 text-sm font-semibold rounded-lg hover:bg-acid-dim transition-colors shadow-glow">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 010 1.972l-11.54 6.347a1.125 1.125 0 01-1.667-.986V5.653z"/>
                    </svg>
                    Lancer l'analyse
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>

{% endblock %}
