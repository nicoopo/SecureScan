{% extends 'layouts/layout.html.twig' %}

{% block title %}Hello ScanController!{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto px-6 py-12">
    <div class="rounded-xl border bg-white shadow-card p-8">
        <h1 class="text-2xl font-bold text-gray-900 mb-4">Hello {{ controller_name }}! ✅</h1>

        <p class="text-gray-600 mb-3">This friendly message is coming from:</p>
        <ul class="list-disc list-inside text-sm text-gray-700">
            <li>Your controller at <code class="bg-gray-100 px-1 py-0.5 rounded">/var/www/html/src/Controller/ScanController.php</code></li>
            <li>Your template at <code class="bg-gray-100 px-1 py-0.5 rounded">/var/www/html/templates/scan/index.html.twig</code></li>
        </ul>
    </div>
</div>
{% endblock %}
