<form class="flex flex-col gap-6" method="post">
  <div class="flex flex-col items-center gap-1 text-center">
    <h1 class="text-2xl font-bold">Créer votre compte</h1>
    <p class="text-sm text-balance text-muted-foreground">
        Remplissez le formulaire ci-dessous pour créer votre compte
    </p>
  </div>
  {{ form_errors(registrationForm) }}
  <div class="space-y-4">
    <div>
      <label for="{{ registrationForm.fullName.vars.id }}" class="block text-sm font-medium mb-2">Nom prénom</label>
      {{ form_widget(registrationForm.fullName, {
        attr: { class: 'w-full rounded-md border px-3 py-2 text-sm shadow focus:outline-none focus:ring-2 focus:ring-blue-900' }
      }) }}
      {{ form_errors(registrationForm.fullName) }}
    </div>
    <div>
      <label for="{{ registrationForm.email.vars.id }}" class="block text-sm font-medium mb-2">Email</label>
      {{ form_widget(registrationForm.email, {
        attr: { class: 'w-full rounded-md border px-3 py-2 text-sm shadow focus:outline-none focus:ring-2 focus:ring-blue-900' }
      }) }}
      <p class="text-sm text-muted-foreground mt-1">
          Nous utiliserons ces informations pour vous contacter. Nous ne partagerons votre adresse e-mail avec personne d'autre.
      </p>
      {{ form_errors(registrationForm.email) }}
    </div>
    <div>
      <label for="{{ registrationForm.plainPassword.vars.id }}" class="block text-sm font-medium mb-2">Mot de passe</label>
      {{ form_widget(registrationForm.plainPassword, {
        attr: { class: 'w-full rounded-md border px-3 py-2 text-sm shadow focus:outline-none focus:ring-2 focus:ring-blue-900' }
      }) }}
      <p class="text-sm text-muted-foreground mt-1">
          Doit comporter au moins 8 caractères.
      </p>
      {{ form_errors(registrationForm.plainPassword) }}
    </div>
    <div>
      <label for="confirm-password" class="block text-sm font-medium mb-2">Confirmez le mot de passe</label>
      <input id="confirm-password" name="confirm_password" type="password" required class="w-full rounded-md border px-3 py-2 text-sm shadow focus:outline-none focus:ring-2 focus:ring-blue-900" />
      <p class="text-sm text-muted-foreground mt-1">Merci de confirmez le mot de passe.</p>
    </div>
      <div class="flex items-center space-x-2">
          {{ form_widget(registrationForm.agreeTerms, {
              attr: { class: 'rounded border focus:ring-2 focus:ring-blue-900' }
          }) }}
          <label for="{{ registrationForm.agreeTerms.vars.id }}" class="text-sm font-medium">
              {{ form_label(registrationForm.agreeTerms) }}
          </label>
      </div>
      {{ form_errors(registrationForm.agreeTerms) }}
      <div class="space-y-2">
          <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-sm font-medium">Créer votre compte</button>
          <p class="text-center text-sm text-gray-600">Déja un compte? <a href="/login" class="underline underline-offset-4 hover:underline">Connexion</a></p>
      </div>
  </div>
  {{ form_rest(registrationForm) }}
</form>

