<div class="flex flex-col gap-6">
    <div class="bg-white border border-gray-200 rounded-lg shadow p-6">
        <div class="mb-4">
            <h2 class="text-lg font-semibold">Create an account</h2>
            <p class="text-sm text-gray-600">Enter your information below to create your account</p>
        </div>
        <div>
            {{ form_errors(registrationForm) }}

            {{ form_start(registrationForm) }}
                <div class="space-y-4">
                    {{ form_row(registrationForm.fullName, {
                        attr: { class: 'mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-red-500 focus:border-red-500' }
                    }) }}

                    {{ form_row(registrationForm.email, {
                        attr: { class: 'mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-red-500 focus:border-red-500' }
                    }) }}

                    {{ form_row(registrationForm.plainPassword, {
                        label: 'Password',
                        attr: { class: 'mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-red-500 focus:border-red-500' }
                    }) }}

                    {{ form_row(registrationForm.agreeTerms, {
                        attr: { class: 'rounded' }
                    }) }}

                    <div class="space-y-2">
                        <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-sm font-medium">Create Account</button>
                        <p class="text-center text-sm text-gray-600">Already have an account? <a href="/login" class="underline underline-offset-4 hover:underline">Sign in</a></p>
                    </div>
                </div>
            {{ form_end(registrationForm) }}
        </div>
    </div>
</div>
