{% extends 'layouts/layout.html.twig' %}

{% block title %}Rapport — {{ scan.project.name }}{% endblock %}

{% block content %}
    <div class="w-full max-w-6xl mx-auto px-4 py-10">

        {# Header #}
        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-2xl font-semibold text-gray-900">{{ scan.project.name }}</h1>
                <p class="text-sm text-gray-500 mt-1">{{ scan.project.repositoryUrl }}</p>
                <p class="text-xs text-gray-400 mt-1">Scan du {{ scan.startedAt|date('d/m/Y à H:i') }}</p>
            </div>
            <div class="flex gap-2">
                <a href="{{ path('app_scan_new') }}"
                   class="border border-gray-300 hover:bg-gray-50 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                    Nouveau scan
                </a>
                <a href="{{ path('report_pdf', {id: scan.id}) }}"
                   class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                    Télécharger PDF
                </a>
                <a href="{{ path('report_html', {id: scan.id}) }}"
                   class="border border-gray-300 hover:bg-gray-50 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                    Exporter HTML
                </a>
                {% if scan.fixBranch %}
                    <div data-controller="git-push"
                         data-git-push-scan-id-value="{{ scan.id }}"
                         data-git-push-csrf-token-value="{{ csrf_token('push_fixes') }}">
                        <button type="button" data-git-push-target="button" data-action="click->git-push#push"
                                class="bg-gray-900 hover:bg-gray-800 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                            Pousser vers GitHub
                        </button>
                        <div data-git-push-target="toast" class="hidden"></div>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Metric cards #}
        {% set counts = scan.countBySeverity() %}
        <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-8">
            <div class="bg-gray-50 rounded-lg p-4">
                <p class="text-xs text-gray-500 mb-1">Score</p>
                <p class="text-3xl font-semibold
                {% if scan.grade == 'A' %}text-green-700
                {% elseif scan.grade == 'B' %}text-blue-700
                {% elseif scan.grade == 'C' %}text-yellow-700
                {% elseif scan.grade == 'D' %}text-orange-700
                {% else %}text-red-700{% endif %}">
                    {{ scan.score ?? 0 }}/100
                </p>
                <p class="text-xs text-gray-400 mt-1">Grade {{ scan.grade ?? '—' }}</p>
            </div>
            <div class="bg-gray-50 rounded-lg p-4">
                <p class="text-xs text-gray-500 mb-1">Critique</p>
                <p class="text-3xl font-semibold text-red-600">{{ counts['critical'] ?? 0 }}</p>
            </div>
            <div class="bg-gray-50 rounded-lg p-4">
                <p class="text-xs text-gray-500 mb-1">Haute</p>
                <p class="text-3xl font-semibold text-orange-500">{{ counts['high'] ?? 0 }}</p>
            </div>
            <div class="bg-gray-50 rounded-lg p-4">
                <p class="text-xs text-gray-500 mb-1">Moyenne</p>
                <p class="text-3xl font-semibold text-blue-600">{{ counts['medium'] ?? 0 }}</p>
            </div>
            <div class="bg-gray-50 rounded-lg p-4">
                <p class="text-xs text-gray-500 mb-1">Total</p>
                <p class="text-3xl font-semibold text-gray-900">{{ scan.findings|length }}</p>
            </div>
        </div>

        {# Graphiques #}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
            <div class="bg-white border border-gray-200 rounded-xl p-5">
                <h2 class="text-sm font-semibold text-gray-900 mb-4">Répartition par sévérité</h2>
                <div style="height: 200px">
                    {{ render_chart(chartSeverity, {'aria-label': 'Sévérité', 'legend': false}) }}
                </div>
            </div>

            <div class="bg-white border border-gray-200 rounded-xl p-5">
                <h2 class="text-sm font-semibold text-gray-900 mb-4">Distribution OWASP Top 10</h2>
                <div style="height: 260px">
                    {{ render_chart(chartOwasp, {'aria-label': 'OWASP', 'legend': false}) }}
                </div>
            </div>
        </div>

        {# Table des findings #}
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden"
             data-controller="report-filters fix-modal"
             data-fix-modal-csrf-token-value="{{ csrf_token('fix_action') }}">
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
                <h2 class="text-sm font-semibold text-gray-900">
                    Findings détectés
                    <span data-report-filters-target="count"
                          class="ml-2 text-xs font-normal text-gray-400">
                        {{ scan.findings|length }} / {{ scan.findings|length }}
                    </span>
                </h2>
                <div class="flex gap-2">
                    <select data-report-filters-target="severity" data-action="change->report-filters#apply"
                            class="text-xs border border-gray-300 rounded-lg px-2 py-1.5 text-gray-700">
                        <option value="">Toutes sévérités</option>
                        <option value="critical" {{ filters.severity == 'critical' ? 'selected' }}>Critique</option>
                        <option value="high"     {{ filters.severity == 'high'     ? 'selected' }}>Haute</option>
                        <option value="medium"   {{ filters.severity == 'medium'   ? 'selected' }}>Moyenne</option>
                        <option value="low"      {{ filters.severity == 'low'      ? 'selected' }}>Basse</option>
                    </select>

                    <select data-report-filters-target="owasp" data-action="change->report-filters#apply"
                            class="text-xs border border-gray-300 rounded-lg px-2 py-1.5 text-gray-700">
                        <option value="">Toutes catégories</option>
                        {% for code, label in constant('App\\Entity\\Finding::OWASP_LABELS') %}
                            <option value="{{ code }}" {{ filters.owasp == code ? 'selected' }}>{{ code }} — {{ label }}</option>
                        {% endfor %}
                    </select>

                    <select data-report-filters-target="tool" data-action="change->report-filters#apply"
                            class="text-xs border border-gray-300 rounded-lg px-2 py-1.5 text-gray-700">
                        <option value="">Tous les outils</option>
                        <option value="securescan"     {{ filters.tool == 'securescan'     ? 'selected' }}>SecureScan (analyse statique)</option>
                        <option value="semgrep"        {{ filters.tool == 'semgrep'        ? 'selected' }}>Semgrep</option>
                        <option value="npm_audit"      {{ filters.tool == 'npm_audit'      ? 'selected' }}>npm audit</option>
                        <option value="composer_audit" {{ filters.tool == 'composer_audit' ? 'selected' }}>composer audit</option>
                        <option value="pip_audit"      {{ filters.tool == 'pip_audit'      ? 'selected' }}>pip-audit</option>
                        <option value="govulncheck"    {{ filters.tool == 'govulncheck'    ? 'selected' }}>govulncheck</option>
                        <option value="bundler_audit"  {{ filters.tool == 'bundler_audit'  ? 'selected' }}>bundler-audit</option>
                        <option value="trufflehog"     {{ filters.tool == 'trufflehog'     ? 'selected' }}>TruffleHog</option>
                        <option value="eslint"         {{ filters.tool == 'eslint'         ? 'selected' }}>ESLint</option>
                        <option value="phpstan"        {{ filters.tool == 'phpstan'        ? 'selected' }}>PHPStan</option>
                    </select>
                </div>
            </div>
            <table class="w-full text-xs">
                <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="text-left px-4 py-3 text-gray-500 font-medium">Fichier</th>
                    <th class="text-left px-4 py-3 text-gray-500 font-medium">Ligne</th>
                    <th class="text-left px-4 py-3 text-gray-500 font-medium">Titre</th>
                    <th class="text-left px-4 py-3 text-gray-500 font-medium">Sévérité</th>
                    <th class="text-left px-4 py-3 text-gray-500 font-medium">OWASP</th>
                    <th class="text-left px-4 py-3 text-gray-500 font-medium">Outil</th>
                    <th class="text-left px-4 py-3 text-gray-500 font-medium">Fix</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                {% for finding in scan.findings %}
                    <tr class="hover:bg-gray-50"
                        data-report-filters-target="row"
                        data-severity="{{ finding.severity }}"
                        data-owasp="{{ finding.owaspCategory }}"
                        data-tool="{{ finding.tool }}">
                        <td class="px-4 py-3 font-mono text-gray-600" title="{{ finding.filePath }}">
                            {{ finding.filePath ? finding.filePath|split('/')|last : '—' }}
                        </td>
                        <td class="px-4 py-3 text-gray-400">{{ finding.line ?? '—' }}</td>
                        <td class="px-4 py-3 text-gray-800">{{ finding.title }}</td>
                        <td class="px-4 py-3">
                        <span class="px-2 py-0.5 rounded text-xs font-medium
                            {% if finding.severity == 'critical' %}bg-red-100 text-red-800
                            {% elseif finding.severity == 'high' %}bg-orange-100 text-orange-800
                            {% elseif finding.severity == 'medium' %}bg-yellow-100 text-yellow-800
                            {% else %}bg-green-100 text-green-800{% endif %}">
                            {{ finding.severity }}
                        </span>
                        </td>
                        <td class="px-4 py-3 text-gray-500">{{ finding.owaspCategory }}</td>
                        <td class="px-4 py-3 text-gray-400">{{ finding.tool }}</td>
                        <td class="px-4 py-3">
                            {% set fix = finding.pendingFix ?? finding.acceptedFix %}
                            {% if fix %}
                                <button type="button"
                                        data-action="fix-modal#open"
                                        class="inline-flex items-center gap-1 font-medium
                                            {{ fix.status == constant('App\\Entity\\Fix::STATUS_ACCEPTED') ? 'text-green-600' : 'text-blue-600 hover:underline' }}"
                                        data-fix-id="{{ fix.id }}"
                                        data-fix-status="{{ fix.status }}"
                                        data-title="{{ finding.title }}"
                                        data-owasp="{{ finding.owaspCategory }}"
                                        data-explanation="{{ fix.explanation|e('html_attr') }}"
                                        data-original="{{ fix.originalCode|e('html_attr') }}"
                                        data-proposed="{{ fix.proposedCode|e('html_attr') }}"
                                        data-file="{{ fix.filePath }}"
                                        data-line="{{ fix.lineStart }}">
                                    {% if fix.status == constant('App\\Entity\\Fix::STATUS_ACCEPTED') %}
                                        ✓ Appliqué
                                    {% else %}
                                        Voir fix
                                    {% endif %}
                                </button>
                            {% else %}
                                <span class="text-gray-300">—</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            {# Modale de correction #}
            <div data-fix-modal-target="overlay"
                 data-action="click->fix-modal#backdropClose"
                 class="hidden opacity-0 transition-opacity duration-150 fixed inset-0 bg-gray-900/50 backdrop-blur-sm z-40 flex items-center justify-center px-4">
                <div data-fix-modal-target="panel"
                     class="opacity-0 scale-95 transition-all duration-150 ease-out bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[85vh] overflow-y-auto">
                    <div class="flex items-start justify-between gap-4 px-6 py-5 border-b border-gray-100">
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <span data-fix-modal-target="badge"
                                      class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-red-50 text-red-700 border border-red-100"></span>
                                <span class="text-[11px] uppercase tracking-wide text-gray-400 font-medium">Correction proposée</span>
                            </div>
                            <h3 data-fix-modal-target="title" class="text-base font-semibold text-gray-900"></h3>
                            <p data-fix-modal-target="location" class="text-xs font-mono text-gray-400 mt-1"></p>
                        </div>
                        <button type="button" data-action="fix-modal#close"
                                class="shrink-0 w-8 h-8 flex items-center justify-center rounded-full text-gray-400 hover:bg-gray-100 hover:text-gray-600 transition-colors">
                            &times;
                        </button>
                    </div>

                    <div class="px-6 py-5 space-y-5 text-sm">
                        <div class="bg-blue-50 border border-blue-100 rounded-lg px-4 py-3">
                            <p class="text-xs font-semibold text-blue-900 mb-1">Explication</p>
                            <p data-fix-modal-target="explanation" class="text-blue-900/90 leading-relaxed"></p>
                        </div>

                        <div data-fix-modal-target="originalWrap">
                            <p class="text-xs font-medium text-gray-500 mb-1.5 flex items-center gap-1">
                                <span class="text-red-500">−</span> Code actuel
                            </p>
                            <pre class="bg-red-50 border border-red-100 rounded-lg p-3 overflow-x-auto"><code data-fix-modal-target="original" class="font-mono text-xs text-red-900 whitespace-pre"></code></pre>
                        </div>

                        <div>
                            <p class="text-xs font-medium text-gray-500 mb-1.5 flex items-center gap-1">
                                <span class="text-green-500">+</span> Correction proposée
                            </p>
                            <pre class="bg-green-50 border border-green-100 rounded-lg p-3 overflow-x-auto"><code data-fix-modal-target="proposed" class="font-mono text-xs text-green-900 whitespace-pre"></code></pre>
                        </div>
                    </div>

                    <div data-fix-modal-target="actions" class="hidden flex justify-end gap-2 px-6 py-4 border-t border-gray-100 bg-gray-50 rounded-b-2xl">
                        <button type="button" data-action="fix-modal#reject"
                                class="border border-gray-300 hover:bg-gray-100 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                            Rejeter
                        </button>
                        <button type="button" data-action="fix-modal#accept"
                                class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                            Accepter
                        </button>
                    </div>
                </div>
            </div>

            <div data-fix-modal-target="toast" class="hidden"></div>
        </div>

    </div>
{% endblock %}
