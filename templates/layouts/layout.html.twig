<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SecureScan{% endblock %}</title>
    {% block head %}{% endblock %}
    {% block stylesheets %}
        {{ importmap('app') }}
    {% endblock %}
</head>
<body class="min-h-screen flex flex-col">
    {% include 'layouts/header.html.twig' %}
    <main class="flex flex-1 flex-col items-center justify-center bg-gradient-to-r from-neutral-300 to-red-400">
        {% block content %}{% endblock %}
    </main>
    {% include 'layouts/footer.html.twig' %}

    {% block javascripts %}{% endblock %}
</body>
</html>
